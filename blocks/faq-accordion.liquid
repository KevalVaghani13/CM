{%- comment -%}
  FAQ accordion theme block.
  Up to 10 question/answer pairs. Per-instance styling is passed to
  component-faq-accordion.css through CSS custom properties; behavior lives in
  faq-accordion.js (<faq-accordion> custom element).
{%- endcomment -%}

{{- 'component-faq-accordion.css' | asset_url | stylesheet_tag -}}
<script src="{{- 'faq-accordion.js' | asset_url -}}" defer="defer"></script>

{%- liquid
  assign faq_id = block.id | replace: '_', '' | downcase
-%}

<faq-accordion
  class="faq-accordion"
  data-allow-multiple="{{- block.settings.allow_multiple -}}"
  style="
    --faq-section-padding: {{ block.settings.section_padding }}px;
    --faq-heading-align: {{ block.settings.heading_alignment }};
    --faq-heading-color: {{ block.settings.heading_color }};
    --faq-heading-size: {{ block.settings.heading_size }}px;
    --faq-item-spacing: {{ block.settings.item_spacing }}px;
    --faq-border-color: {{ block.settings.border_color }};
    --faq-border-radius: {{ block.settings.border_radius }}px;
    --faq-item-background: {{ block.settings.item_background }};
    --faq-question-padding: {{ block.settings.question_padding }}px;
    --faq-question-background: {{ block.settings.question_background }};
    --faq-question-hover-background: {{ block.settings.question_hover_background }};
    --faq-question-color: {{ block.settings.question_color }};
    --faq-question-size: {{ block.settings.question_size }}px;
    --faq-icon-color: {{ block.settings.icon_color }};
    --faq-answer-background: {{ block.settings.answer_background }};
    --faq-answer-color: {{ block.settings.answer_color }};
    --faq-answer-size: {{ block.settings.answer_size }}px;
    --faq-answer-padding: {{ block.settings.answer_padding }}px;
  "
  {{ block.shopify_attributes }}
>
  {%- if block.settings.heading != blank -%}
    <h2 class="faq-accordion__heading">{{ block.settings.heading }}</h2>
  {%- endif -%}

  <div class="faq-accordion__list">
    {%- for i in (1..10) -%}
      {%- liquid
        assign question_key = 'question_' | append: i
        assign answer_key = 'answer_' | append: i
        assign question = block.settings[question_key]
        assign answer = block.settings[answer_key]
      -%}

      {%- if question != blank -%}
        <div class="faq-accordion__item" data-faq-item>
          <button
            type="button"
            class="faq-accordion__question"
            id="FaqQuestion-{{ faq_id }}-{{ i }}"
            aria-expanded="false"
            aria-controls="FaqAnswer-{{ faq_id }}-{{ i }}"
            data-faq-button
          >
            <span>{{ question }}</span>
            <svg
              class="faq-accordion__icon"
              aria-hidden="true"
              focusable="false"
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <polyline points="6 9 12 15 18 9"></polyline>
            </svg>
          </button>
          <div
            class="faq-accordion__answer"
            id="FaqAnswer-{{ faq_id }}-{{ i }}"
            role="region"
            aria-labelledby="FaqQuestion-{{ faq_id }}-{{ i }}"
          >
            <div class="faq-accordion__answer-inner">
              <div class="faq-accordion__answer-content">{{ answer }}</div>
            </div>
          </div>
        </div>
      {%- endif -%}
    {%- endfor -%}
  </div>
</faq-accordion>

{% schema %}
{
  "name": "FAQ accordion",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Frequently Asked Questions"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 20,
      "max": 50,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#111111"
    },
    {
      "type": "header",
      "content": "Question 1"
    },
    {
      "type": "text",
      "id": "question_1",
      "label": "Question",
      "default": "What is your return policy?"
    },
    {
      "type": "richtext",
      "id": "answer_1",
      "label": "Answer",
      "default": "<p>We offer a 30-day return policy on all items. Products must be in original condition with tags attached.</p>"
    },
    {
      "type": "header",
      "content": "Question 2"
    },
    {
      "type": "text",
      "id": "question_2",
      "label": "Question",
      "default": "How long does shipping take?"
    },
    {
      "type": "richtext",
      "id": "answer_2",
      "label": "Answer",
      "default": "<p>Standard shipping takes 5-7 business days. Express shipping is available for 2-3 business days delivery.</p>"
    },
    {
      "type": "header",
      "content": "Question 3"
    },
    {
      "type": "text",
      "id": "question_3",
      "label": "Question",
      "default": "Do you ship internationally?"
    },
    {
      "type": "richtext",
      "id": "answer_3",
      "label": "Answer",
      "default": "<p>Yes, we ship to most countries worldwide. International shipping times vary by location.</p>"
    },
    {
      "type": "header",
      "content": "Question 4"
    },
    {
      "type": "text",
      "id": "question_4",
      "label": "Question",
      "default": "How can I track my order?"
    },
    {
      "type": "richtext",
      "id": "answer_4",
      "label": "Answer",
      "default": "<p>Once your order ships, you'll receive a tracking number via email to monitor your delivery.</p>"
    },
    {
      "type": "header",
      "content": "Question 5"
    },
    {
      "type": "text",
      "id": "question_5",
      "label": "Question",
      "default": "What payment methods do you accept?"
    },
    {
      "type": "richtext",
      "id": "answer_5",
      "label": "Answer",
      "default": "<p>We accept all major credit cards, PayPal, and other secure payment methods.</p>"
    },
    {
      "type": "header",
      "content": "Question 6"
    },
    {
      "type": "text",
      "id": "question_6",
      "label": "Question",
      "default": "Can I modify my order after placing it?"
    },
    {
      "type": "richtext",
      "id": "answer_6",
      "label": "Answer",
      "default": "<p>Please contact us immediately if you need to modify your order. We'll do our best to accommodate changes before shipping.</p>"
    },
    {
      "type": "header",
      "content": "Question 7"
    },
    {
      "type": "text",
      "id": "question_7",
      "label": "Question",
      "default": "Do you offer gift wrapping?"
    },
    {
      "type": "richtext",
      "id": "answer_7",
      "label": "Answer",
      "default": "<p>Yes, we offer complimentary gift wrapping. Select this option at checkout and include your personalized message.</p>"
    },
    {
      "type": "header",
      "content": "Question 8"
    },
    {
      "type": "text",
      "id": "question_8",
      "label": "Question",
      "default": "What is your warranty policy?"
    },
    {
      "type": "richtext",
      "id": "answer_8",
      "label": "Answer",
      "default": "<p>All products come with a 1-year manufacturer warranty covering defects in materials and workmanship.</p>"
    },
    {
      "type": "header",
      "content": "Question 9"
    },
    {
      "type": "text",
      "id": "question_9",
      "label": "Question",
      "default": "How do I care for my product?"
