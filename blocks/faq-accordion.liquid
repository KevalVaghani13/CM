    {
      "type": "color",
      "id": "question_color",
      "label": "Question color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "question_background",
      "label": "Question background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "question_hover_background",
      "label": "Question hover background",
      "default": "#f5f5f5"
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Icon color",
      "default": "#111111"
    },
    {
      "type": "header",
      "content": "Answer style"
    },
    {
      "type": "range",
      "id": "answer_size",
      "label": "Answer size",
      "min": 12,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "answer_padding",
      "label": "Answer padding",
      "min": 10,
      "max": 30,
      "step": 2,
      "unit": "px",
      "default": 18
    },
    {
      "type": "color",
      "id": "answer_color",
      "label": "Answer color",
      "default": "#5E5A59"
    },
    {
      "type": "color",
      "id": "answer_background",
      "label": "Answer background",
      "default": "#ffffff"
    }
  ],
  "presets": [
    {
      "name": "FAQ accordion"
    }
  ]
}
{% endschema %}
