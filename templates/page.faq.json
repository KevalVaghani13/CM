    "accordions_iTNECr": {
      "type": "accordions",
      "blocks": {
        "topic_3WhJht": {
          "type": "topic",
          "settings": {
            "is_open": false,
            "title": "What is a Moissanite Tennis Necklace or Bracelet?",
            "content": "<p>A Moissanite Tennis Necklace or Bracelet features a continuous row of sparkling moissanite stones set in a sleek and flexible line, designed to give a luxurious and timeless look.</p>",
            "page": ""
          }
        },
        "topic_UJGWwW": {
          "type": "topic",
          "settings": {
