    "accordions_epKqxf": {
      "type": "accordions",
      "blocks": {
        "topic_qa7NjP": {
          "type": "topic",
          "settings": {
            "is_open": false,
            "title": "⛭ How long will my order take?",
            "content": "<p>✧ Each piece of our ethical fine jewelry is hand made especially for you, with love and care. Your beautiful piece of jewelry will be made in max. 3 weeks with shipping time. Custom, Customized and Engraved pieces will require additional time.</p>",
            "page": ""
          }
        },
        "topic_4eJjce": {
          "type": "topic",
          "settings": {
            "is_open": false,
            "title": "⛭ Do you ship Internationally?",
            "content": "<p>✧ Yes, we ship our jewelry all over the world.</p>",
            "page": ""
          }
        },
        "topic_W7h9eh": {
          "type": "topic",
          "settings": {
            "is_open": false,
            "title": "⛭ How do I track my order?",
            "content": "<p>✧ Once, we dispatch your jewelry from our manufacturing unit after that we will update you with the tracking information so you can track your package. If you facing any error to track your jewelry please contact us at <a href=\"mailto:support@crownmoissanite.com.\" target=\"_blank\" title=\"mailto:support@crownmoissanite.com.\">support@crownmoissanite.com.</a></p>",
            "page": ""
          }
        },
        "topic_QbX8Mx": {
          "type": "topic",
          "settings": {
            "is_open": false,
            "title": "⛭ Can I change my shipping address before item ship?",
            "content": "<p>✧ Yes, you can change the address before item ship from our manufacturing facility by sending a direct message, once the item is shipped out you can't change. We will not be responsible for any loss of parcel that occurs due to a wrong address.</p><h2></h2>",
            "page": ""
          }
        }
      },
