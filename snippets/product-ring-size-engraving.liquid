{%- assign has_ring_size_tag = false -%}
{%- assign has_engrave_tag = false -%}
{%- if product.tags contains 'ring-size' -%}
  {%- assign has_ring_size_tag = true -%}
{%- endif -%}
{%- if product.tags contains 'engrave' -%}
  {%- assign has_engrave_tag = true -%}
{%- endif -%}

{%- if block.settings.enable_ring_size and has_ring_size_tag or block.settings.enable_engraving and has_engrave_tag -%}
  <div class="product__ring-size-engraving" {{ block.shopify_attributes }}>
    {%- if block.settings.enable_ring_size and has_ring_size_tag -%}
      <div class="product-form__input" style="margin-bottom: 15px;">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 5px;">
          <label class="form__label" for="RingSize-{{ section.id }}" style="margin-bottom: 0; display: inline-block;">Ring Size: <span id="RingSizeDisplay-{{ section.id }}"></span></label>
          <button type="button" class="ring-size-guide-trigger" id="RingSizeGuideTrigger-{{ section.id }}" aria-haspopup="dialog" style="background: none; border: none; padding: 0; font-family: inherit; font-size: 1.3rem; text-decoration: underline; color: #121212; cursor: pointer; transition: opacity 0.2s ease;">Find my ring size</button>
        </div>
        
        {%- capture ring_size_options -%}
          <option value="">Select Ring Size</option>
          {%- for i in (12..48) -%}
            {%- assign remainder = i | modulo: 4 -%}
            {%- assign base = i | divided_by: 4 -%}
            {%- if remainder == 0 -%}
              {%- assign size_str = base | append: '' -%}
            {%- elsif remainder == 1 -%}
              {%- assign size_str = base | append: '.25' -%}
            {%- elsif remainder == 2 -%}
              {%- assign size_str = base | append: '.5' -%}
            {%- elsif remainder == 3 -%}
              {%- assign size_str = base | append: '.75' -%}
            {%- endif -%}
            <option value="US {{ size_str }}">US {{ size_str }}</option>
          {%- endfor -%}
        {%- endcapture -%}
        
        <style>
          .custom-pill-input .dropdown__summary {
            border-radius: 50px;
          }
          .custom-pill-input .field__input {
            border-radius: 50px;
          }

          /* Drawer Styles */
          .ring-size-drawer-wrapper {
            position: fixed;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            z-index: 999999;
            visibility: hidden;
            opacity: 0;
            transition: visibility 0.3s ease, opacity 0.3s ease;
          }

          .ring-size-drawer-wrapper.is-open {
            visibility: visible;
            opacity: 1;
          }

          .ring-size-drawer__overlay {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.5);
            backdrop-filter: blur(2px);
          }

          .ring-size-drawer__panel {
            position: absolute;
            top: 0;
            right: 0;
            width: 100%;
            max-width: 480px;
            height: 100%;
            background: #ffffff;
            box-shadow: -5px 0 25px rgba(0, 0, 0, 0.15);
            transform: translateX(100%);
            transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
            display: flex;
            flex-direction: column;
            padding: 30px 24px 24px 24px;
            z-index: 2;
            box-sizing: border-box;
          }

          .ring-size-drawer-wrapper.is-open .ring-size-drawer__panel {
            transform: translateX(0);
          }

          .ring-size-drawer__close {
            position: absolute;
            top: 20px;
            right: 20px;
            background: transparent;
            border: none;
            cursor: pointer;
            padding: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 50%;
            color: #333;
            transition: background-color 0.2s ease, color 0.2s ease;
            z-index: 10;
          }

          .ring-size-drawer__close:hover {
            background-color: #f0f0f0;
            color: #000;
          }

          .popup-link__inner {
            display: flex;
            flex-direction: column;
            height: 100%;
            overflow: hidden;
          }

          .popup-custom-header h3 {
            font-size: 2.2rem;
            font-weight: 600;
            margin: 0 0 6px 0;
            color: #121212;
            letter-spacing: -0.01em;
          }

          .popup-desc p {
            font-size: 1.3rem;
            color: #666;
            margin: 0 0 20px 0;
            line-height: 1.4;
          }

          .ring-size-chart {
            display: flex;
            flex-direction: column;
            flex: 1;
            min-height: 0;
          }

          .chart-header {
            font-size: 1.6rem;
            font-weight: 600;
            margin-bottom: 12px;
            color: #121212;
          }

          .table-scroll {
            flex: 1;
            overflow-y: auto;
            border: 1px solid #e5e5e5;
            border-radius: 8px;
            background: #fff;
          }

          .chart-table {
            width: 100%;
            display: flex;
            flex-direction: column;
          }

          .table-head {
            display: grid;
            grid-template-columns: 1fr 1.2fr 1.4fr;
            background: #f7f7f7;
            font-weight: 600;
            font-size: 1.2rem;
            color: #121212;
            position: sticky;
            top: 0;
            z-index: 2;
            border-bottom: 1px solid #e5e5e5;
            text-align: center;
          }

          .table-head > div {
            padding: 12px 6px;
            display: flex;
            align-items: center;
            justify-content: center;
          }

          .table-body {
            display: flex;
            flex-direction: column;
          }

          .table-row {
            display: grid;
            grid-template-columns: 1fr 1.2fr 1.4fr;
            border-bottom: 1px solid #f0f0f0;
            font-size: 1.3rem;
            color: #333;
            text-align: center;
            transition: background-color 0.15s ease;
          }

          .table-row:nth-child(even) {
            background-color: #fafafa;
          }

          .table-row:hover {
            background-color: #f2f5f8;
          }

          .table-row > div {
            padding: 10px 6px;
            display: flex;
            align-items: center;
            justify-content: center;
          }
        </style>
        
