  <script>
    document.addEventListener('DOMContentLoaded', function() {
      const ringSizeSelect = document.getElementById('RingSize-{{ section.id }}');
      const engravingInput = document.getElementById('Engraving-{{ section.id }}');
      const engravingCounter = document.getElementById('EngravingCounter-{{ section.id }}');
      const engravingCharCount = document.getElementById('EngravingCharCount-{{ section.id }}');
      const ringSizeDisplay = document.getElementById('RingSizeDisplay-{{ section.id }}');

      const triggerBtn = document.getElementById('RingSizeGuideTrigger-{{ section.id }}');
      const drawerWrapper = document.getElementById('RingSizeDrawer-{{ section.id }}');
      const overlay = document.getElementById('RingSizeDrawerOverlay-{{ section.id }}');
      const closeBtn = document.getElementById('RingSizeDrawerClose-{{ section.id }}');

      function openDrawer() {
        if (drawerWrapper) {
          drawerWrapper.classList.add('is-open');
          drawerWrapper.setAttribute('aria-hidden', 'false');
          document.body.style.overflow = 'hidden';
        }
      }

      function closeDrawer() {
        if (drawerWrapper) {
          drawerWrapper.classList.remove('is-open');
          drawerWrapper.setAttribute('aria-hidden', 'true');
          document.body.style.overflow = '';
        }
      }

      if (triggerBtn) {
        triggerBtn.addEventListener('click', function(e) {
          e.preventDefault();
          openDrawer();
        });
      }

      if (overlay) {
        overlay.addEventListener('click', closeDrawer);
      }

      if (closeBtn) {
        closeBtn.addEventListener('click', closeDrawer);
      }

      document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape' && drawerWrapper && drawerWrapper.classList.contains('is-open')) {
          closeDrawer();
        }
      });

      function updateEngravingLimits() {
        let maxChars = 15;
        if (ringSizeSelect && ringSizeSelect.value) {
          if (ringSizeDisplay) {
            ringSizeDisplay.textContent = ringSizeSelect.value;
          }
          const sizeString = ringSizeSelect.value.replace('US ', '');
          const size = parseFloat(sizeString);
          if (!isNaN(size) && size < 5) {
            maxChars = 10;
          }
        } else if (ringSizeSelect && !ringSizeSelect.value) {
           if (ringSizeDisplay) {
            ringSizeDisplay.textContent = '';
          }
        }

        if (engravingInput) {
          engravingInput.setAttribute('maxlength', maxChars);
          if (engravingCounter) {
            engravingCounter.textContent = `(Max ${maxChars} characters)`;
          }
          
          if (engravingInput.value.length > maxChars) {
            engravingInput.value = engravingInput.value.substring(0, maxChars);
          }
          
          if (engravingCharCount) {
            engravingCharCount.textContent = `${engravingInput.value.length}/${maxChars}`;
          }
        }
      }

      if (ringSizeSelect) {
        ringSizeSelect.addEventListener('change', updateEngravingLimits);
      }

      if (engravingInput) {
        engravingInput.addEventListener('input', updateEngravingLimits);
      }

      updateEngravingLimits();
    });
  </script>
{%- endif -%}
